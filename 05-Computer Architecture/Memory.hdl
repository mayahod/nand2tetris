// File name: projects/05/Memory.hdl

/**
 * The complete address space of the Hack computer's memory:
 *
 * 0x0000-0x3FFF : RAM16K
 * 0x4000-0x5FFF : Screen
 * 0x6000        : Keyboard
 *
 * The Keyboard is read-only. Addresses above 0x6000 are outside the
 * valid Hack memory map.
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Decode the write target using address[13..14].
    // 00 / 01 -> RAM, 10 -> Screen, 11 -> Keyboard/invalid (no write).
    DMux4Way(
        in=load,
        sel=address[13..14],
        a=loadRamLow,
        b=loadRamHigh,
        c=loadScreen,
        d=ignoreWrite
    );
    Or(a=loadRamLow, b=loadRamHigh, out=loadRam);

    RAM16K(
        in=in,
        load=loadRam,
        address=address[0..13],
        out=ramOut
    );

    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    Keyboard(out=keyboardOut);

    // Reading uses the same memory-map split. The fourth selector value
    // covers the keyboard address; values above 0x6000 are unspecified.
    Mux4Way16(
        a=ramOut,
        b=ramOut,
        c=screenOut,
        d=keyboardOut,
        sel=address[13..14],
        out=out
    );
}
